{
	"name": "growtube",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"dev:extension": "turbo run dev -F extension --",
		"db:push": "turbo run db:push -F @growtube/db --",
		"db:studio": "turbo run db:studio -F @growtube/db --",
		"db:generate": "turbo run db:generate -F @growtube/db --",
		"db:migrate": "turbo run db:migrate -F @growtube/db --",
		"deploy": "pnpm --filter @growtube/infra run deploy",
		"destroy": "pnpm --filter @growtube/infra run destroy",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@cloudflare/workers-types": "catalog:",
		"@growtube/config": "workspace:*",
		"@types/node": "catalog:",
		"lefthook": "^2.2.2",
		"turbo": "^2.11.11",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "pnpm@11.25.0"
}
