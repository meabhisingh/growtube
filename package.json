{
  "name": "open-vidiq",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev:bare -F hono --",
    "db:push": "turbo run db:push -F @open-vidiq/db --",
    "db:studio": "turbo run db:studio -F @open-vidiq/db --",
    "db:generate": "turbo run db:generate -F @open-vidiq/db --",
    "db:migrate": "turbo run db:migrate -F @open-vidiq/db --",
    "deploy": "turbo run deploy -F @open-vidiq/infra --",
    "destroy": "turbo run destroy -F @open-vidiq/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "check": "biome check --write ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@cloudflare/workers-types": "catalog:",
    "@open-vidiq/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "^2.2.2",
    "turbo": "^2.11.11",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
