# Chrome Web Store build (`pnpm --filter extension zip:store`).
# Public URLs only, never secrets: both end up in the published extension.
# Local `dev` and `build` don't read this file and stay on localhost.

# GrowTube server (Hono worker): the default "Server URL" setting, and added
# to the manifest's host_permissions at build time.
WXT_SERVER_URL=https://growtube-api.meabhisingh25.workers.dev

# GrowTube web app for that server (MCP API keys are managed there).
WXT_WEB_URL=https://growtube.meabhisingh25.workers.dev

# Marks the zip:store build: wxt.config.ts then checks that the built
# manifest really points at WXT_SERVER_URL above before writing the ZIP.
GROWTUBE_STORE_ZIP=1
