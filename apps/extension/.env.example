# open-vidiq server (Hono worker). Used as the default "Server URL" setting
# and added to the manifest's host_permissions at build time.
WXT_SERVER_URL=http://localhost:3000

# Optional: the open-vidiq web app for that server (MCP API keys are managed
# there). The extension's Account section links to it when set.
WXT_WEB_URL=http://localhost:3001
