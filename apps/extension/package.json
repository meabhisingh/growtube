{
	"name": "extension",
	"version": "1.0.1",
	"private": true,
	"description": "manifest.json description",
	"type": "module",
	"scripts": {
		"dev": "wxt --port 5555",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:store": "node --env-file=.env.store node_modules/wxt/bin/wxt.mjs zip",
		"zip:firefox": "wxt zip -b firefox",
		"check-types": "tsc --noEmit",
		"live-check": "node scripts/run-live-check.mjs",
		"icons": "node scripts/generate-icons.mjs",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@growtube/shared": "workspace:*",
		"@growtube/ui": "workspace:*",
		"lucide-react": "catalog:",
		"openai": "^7.57.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.5",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@wxt-dev/module-react": "^1.1.5",
		"sharp": "0.35.5",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"web-ext": "^10.5.0",
		"wxt": "^0.21.3"
	}
}
