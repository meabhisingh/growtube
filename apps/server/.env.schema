# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Redis connection string (ioredis). Use rediss:// for TLS in production.
# @type=string(minLength=1)
REDIS_URL=

# YouTube Data API v3 key for the hourly stats refresh cron (videos.list /
# channels.list). Optional: without it the cron only prunes old snapshots.
# @optional @type=string
YOUTUBE_API_KEY=

# Extension origins allowed to sign in / sign up with bearer tokens, as a
# comma-separated list of chrome-extension://<32-letter id>. Optional: when
# unset, any chrome-extension:// origin may call those two endpoints (only
# without cookies). Set it to your published extension's id in production.
# @optional @public @type=string
EXTENSION_ORIGINS=
